<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>openshape</AssemblyName>
    <RootNamespace>OpenShape</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.0.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../engine/target/release/libopenshape_engine.so" Link="libopenshape_engine.so" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../occt/build/libopenshape_occt.so" Link="libopenshape_occt.so" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
